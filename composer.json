{
	"name": "gcgov/framework-service-auth-oauth-server",
	"type": "framework-service",
	"description": "Plugin enables a full fledged oauth server generating access and refresh tokens. Authentication can be provided as username/password or via third party Oauth providers.",
	"license": "MIT",
	"autoload": {
		"psr-4": {
			"gcgov\\framework\\services\\authoauth\\": "src/"
		}
	},
	"require": {
		"php": ">=8.2",
		"hybridauth/hybridauth": "3.11.*",
		"lcobucci/jwt": "^5.6",
		"lcobucci/clock": "^2.0",
		"andrewsauder/json-deserialize": "^3.0",
		"robthree/twofactorauth": "^3.0",
		"bacon/bacon-qr-code": "^3.0",
		"ext-mongodb": "*",
		"ext-imagick": "*",
		"ext-sodium": "*"
	},
	"require-dev": {
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5",
		"jetbrains/phpstorm-attributes": "^1.0",
		"gcgov/framework": "dev-main"
	},
	"repositories": [
		{ "type": "path", "url": "../framework*", "options": { "symlink": true } }
	],
	"scripts": {
		"phpstan": "phpstan analyse --memory-limit=512M",
		"test": "phpunit",
		"ci": ["@phpstan", "@test"]
	}
}
